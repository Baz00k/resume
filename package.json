{
	"name": "resume-generator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/pdf.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check && oxlint",
		"format": "oxfmt"
	},
	"devDependencies": {
		"@iconify-json/devicon": "^1.2.71",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/logos": "^1.2.17",
		"@iconify-json/material-symbols": "^1.2.95",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/simple-icons": "^1.2.100",
		"@iconify-json/skill-icons": "^1.2.4",
		"@iconify-json/tabler": "^1.2.42",
		"@iconify-json/twemoji": "^1.2.5",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^24.19.2",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"playwright": "^1.64.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.4"
	},
	"packageManager": "pnpm@12.14.0"
}
